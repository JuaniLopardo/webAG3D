---
import '../styles/global.css';
interface Props {
	title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} | AG3D</title>
	</head>
	<body>
		<slot />
	</body>
</html>
