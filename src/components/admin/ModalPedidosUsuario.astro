---
// src/components/admin/ModalPedidosUsuario.astro
---
<div id="modal-pedidos" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-[60] p-4">
  <div class="bg-white p-6 rounded-xl shadow-2xl w-full max-w-4xl max-h-[85vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-6 border-b pb-4">
      <h3 class="text-xl font-bold text-gray-900">Historial de Pedidos</h3>
      <button id="btn-cerrar-pedidos" class="text-gray-400 hover:text-gray-600 text-2xl font-bold transition-transform hover:scale-110">&times;</button>
    </div>
    <div id="pedidos-cliente-container">
      <p class="text-gray-500 italic text-center py-10">Cargando historial...</p>
    </div>
  </div>
</div>
