---
// src/components/admin/ModalProducto.astro
---
<div id="modal-producto" class="fixed inset-0 bg-black bg-opacity-50 hidden flex-col items-center justify-center z-50 px-4 transition-opacity">
  <div class="bg-white p-6 rounded-xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
    <h3 id="modal-producto-titulo" class="text-xl font-bold text-gray-900 mb-6">Agregar Producto</h3>
    
    <form id="form-producto" class="space-y-4">
      <input type="hidden" id="prod-id" />
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-1">Título del Producto</label>
          <input type="text" id="prod-titulo" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary" />
        </div>
        
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
          <textarea id="prod-desc" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary"></textarea>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Cantidad Mínima</label>
          <input type="number" id="prod-min" min="1" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Precio (Opcional)</label>
          <input type="number" id="prod-precio" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary" />
        </div>

        <div class="md:col-span-2 bg-blue-50 p-4 rounded-lg border border-blue-100 mt-2">
          <label class="block text-sm font-bold text-blue-900 mb-1">Subir Imágenes (Opcional)</label>
          <input type="file" id="prod-fotos" multiple accept="image/*" class="w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 transition" />
          <div id="preview-fotos-container" class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-4"></div>
          <p class="text-xs text-blue-700 mt-2">Puedes seleccionar varias fotos a la vez. Si subes fotos nuevas, reemplazarán a las anteriores.</p>
        </div>

        <div class="md:col-span-2 border-t border-gray-200 pt-4 mt-2">
          <div class="flex justify-between items-center mb-3">
            <label class="block text-sm font-bold text-gray-800">Variables Opcionales</label>
            <button type="button" id="btn-add-var" class="text-xs bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1.5 rounded-md font-bold transition">+ Agregar Variable</button>
          </div>
          <div id="variables-container" class="space-y-3"></div>
        </div>
      </div>

      <p id="modal-prod-mensaje" class="text-sm font-semibold text-center mt-4 h-4"></p>

      <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-4">
        <button type="button" id="btn-cerrar-modal" class="px-4 py-2 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition">Cancelar</button>
        <button type="submit" id="btn-guardar-producto" class="px-4 py-2 bg-primary text-white font-semibold rounded-lg hover:bg-primary-hover transition">Guardar Producto</button>
      </div>
    </form>
  </div>
</div>
