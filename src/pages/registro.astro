---
// src/pages/registro.astro
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Registro - AG3D</title>
  </head>
  <body class="bg-gray-100 text-gray-800 font-sans min-h-screen flex flex-col items-center justify-center p-4">
    
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8 border border-gray-200">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Crear Cuenta</h1>
        <p class="text-gray-500 mt-2">Únete a AG3D para gestionar tus pedidos personalizados</p>
      </div>

      <form id="form-registro" class="space-y-5">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Correo Electrónico</label>
          <input type="email" id="reg-email" required class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="tu@email.com" />
        </div>
        
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Contraseña</label>
          <input type="password" id="reg-password" required minlength="6" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="••••••••" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Confirmar Contraseña</label>
          <input type="password" id="reg-confirm" required class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="••••••••" />
        </div>

        <p id="mensaje-error" class="text-red-500 text-xs font-semibold text-center h-4"></p>

        <button type="submit" id="btn-registrar" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition-all shadow-lg hover:shadow-blue-200 active:scale-[0.98]">
          Registrarse
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-gray-100 text-center">
        <p class="text-gray-600 text-sm">
          ¿Ya tienes una cuenta? 
          <a href="/login" class="text-blue-600 font-bold hover:underline">Inicia Sesión</a>
        </p>
        <a href="/" class="block mt-4 text-xs text-gray-400 hover:text-gray-600 transition-colors">Volver al catálogo</a>
      </div>
    </div>

    <script>
      // @ts-ignore
      import { supabase } from '../lib/supabase';

      const form = document.getElementById('form-registro') as HTMLFormElement;
      const btn = document.getElementById('btn-registrar') as HTMLButtonElement;
      const msg = document.getElementById('mensaje-error') as HTMLParagraphElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const email = (document.getElementById('reg-email') as HTMLInputElement).value;
        const password = (document.getElementById('reg-password') as HTMLInputElement).value;
        const confirm = (document.getElementById('reg-confirm') as HTMLInputElement).value;

        if (password !== confirm) {
          msg.textContent = 'Las contraseñas no coinciden';
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Creando cuenta...';
        msg.textContent = '';

        const { data, error } = await supabase.auth.signUp({
          email,
          password
        });

        if (error) {
          msg.textContent = error.message;
          btn.disabled = false;
          btn.textContent = 'Registrarse';
          return;
        }

        if (data.user) {
          alert('¡Registro exitoso! Ya puedes iniciar sesión.');
          window.location.href = '/login';
        }
      });
    </script>
  </body>
</html>