---
// src/pages/dashboard.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mi Perfil">
  <div class="min-h-screen flex flex-col">
    <main class="container mx-auto px-4 py-12 max-w-2xl flex-grow">
      <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-200">
        <div class="mb-8 border-b pb-4">
          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Mi Perfil</h1>
          <p class="text-gray-500 mt-1">Gestiona tus datos de contacto y facturación</p>
        </div>

        <form id="form-perfil" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-gray-700 mb-1">Nombre Completo *</label>
              <input type="text" id="dash-nombre" required class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary outline-none transition bg-gray-50" />
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Teléfono *</label>
              <input type="tel" id="dash-tel" required class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary outline-none transition bg-gray-50" />
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Email (No editable)</label>
              <input type="email" id="dash-email" disabled class="w-full px-4 py-2.5 border border-gray-300 rounded-xl bg-gray-100 text-gray-500 cursor-not-allowed" />
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Empresa (Opcional)</label>
              <input type="text" id="dash-empresa" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary outline-none transition bg-gray-50" />
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Instagram (Opcional)</label>
              <input type="text" id="dash-instagram" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary outline-none transition bg-gray-50" placeholder="@usuario" />
            </div>
          </div>

          <div id="mensaje-dash" class="text-center h-4 text-sm font-semibold"></div>

          <div class="pt-4">
            <button type="button" id="btn-logout-dash" class="w-full mb-3 bg-red-50 hover:bg-red-100 text-red-600 font-bold py-2 rounded-xl transition text-sm">
              Cerrar Sesión
            </button>
            <button type="submit" id="btn-guardar-perfil" class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-3 rounded-xl transition-all shadow-lg active:scale-[0.98]">
              Guardar Cambios
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    // @ts-ignore
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('form-perfil') as HTMLFormElement;
    const btn = document.getElementById('btn-guardar-perfil') as HTMLButtonElement;
    const msg = document.getElementById('mensaje-dash') as HTMLParagraphElement;
    const btnLogout = document.getElementById('btn-logout-dash') as HTMLButtonElement;

    const inputNombre = document.getElementById('dash-nombre') as HTMLInputElement;
    const inputTel = document.getElementById('dash-tel') as HTMLInputElement;
    const inputEmail = document.getElementById('dash-email') as HTMLInputElement;
    const inputEmpresa = document.getElementById('dash-empresa') as HTMLInputElement;
    const inputInstagram = document.getElementById('dash-instagram') as HTMLInputElement;

    document.addEventListener('DOMContentLoaded', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { window.location.href = '/login'; return; }

      const { data: perfil } = await supabase.from('perfiles').select('*').eq('id', session.user.id).single();
      if (perfil) {
        inputNombre.value = perfil.nombre_completo || '';
        inputTel.value = perfil.telefono || '';
        inputEmail.value = perfil.email || session.user.email || '';
        inputEmpresa.value = perfil.nombre_empresa || '';
        inputInstagram.value = perfil.instagram || '';
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;
      btn.disabled = true; btn.textContent = 'Guardando...'; msg.textContent = '';

      const { error } = await supabase.from('perfiles').update({
        nombre_completo: inputNombre.value.trim(),
        telefono: inputTel.value.trim(),
        nombre_empresa: inputEmpresa.value.trim(),
        instagram: inputInstagram.value.trim()
      }).eq('id', session.user.id);

      if (error) {
        msg.textContent = 'Error al actualizar el perfil'; msg.className = 'text-center h-4 text-sm font-semibold text-red-500';
      } else {
        msg.textContent = '¡Perfil actualizado con éxito!'; msg.className = 'text-center h-4 text-sm font-semibold text-green-600';
      }
      btn.disabled = false; btn.textContent = 'Guardar Cambios';
    });

    btnLogout.addEventListener('click', async () => { await supabase.auth.signOut(); window.location.href = '/login'; });
  </script>
</Layout>