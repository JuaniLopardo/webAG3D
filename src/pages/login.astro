---
// src/pages/login.astro
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Iniciar Sesión - AG3D</title>
  </head>
  <body class="bg-gray-100 text-gray-800 font-sans min-h-screen flex flex-col items-center justify-center p-4">
    
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8 border border-gray-200">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Bienvenido</h1>
        <p class="text-gray-500 mt-2">Ingresa a tu cuenta para ver tus pedidos</p>
      </div>

      <form id="form-login" class="space-y-5">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Correo Electrónico</label>
          <input type="email" id="login-email" required class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="tu@email.com" />
        </div>
        
        <div>
          <div class="flex justify-between items-center mb-1">
            <label class="text-sm font-semibold text-gray-700">Contraseña</label>
            <a href="#" class="text-xs text-blue-600 hover:underline">¿Olvidaste tu contraseña?</a>
          </div>
          <input type="password" id="login-password" required class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="••••••••" />
        </div>

        <p id="mensaje-error" class="text-red-500 text-xs font-semibold text-center h-4"></p>

        <button type="submit" id="btn-ingresar" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition-all shadow-lg hover:shadow-blue-200 active:scale-[0.98]">
          Ingresar
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-gray-100 text-center">
        <p class="text-gray-600 text-sm">
          ¿No tienes una cuenta? 
          <a href="/registro" class="text-blue-600 font-bold hover:underline">Regístrate gratis</a>
        </p>
        <a href="/" class="block mt-4 text-xs text-gray-400 hover:text-gray-600 transition-colors">Volver al catálogo</a>
      </div>
    </div>

    <script>
      // @ts-ignore
      import { supabase } from '../lib/supabase';

      const form = document.getElementById('form-login') as HTMLFormElement;
      const btn = document.getElementById('btn-ingresar') as HTMLButtonElement;
      const msg = document.getElementById('mensaje-error') as HTMLParagraphElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const email = (document.getElementById('login-email') as HTMLInputElement).value;
        const password = (document.getElementById('login-password') as HTMLInputElement).value;

        btn.disabled = true;
        btn.textContent = 'Iniciando sesión...';
        msg.textContent = '';

        // 1. Intentar inicio de sesión
        const { data, error } = await supabase.auth.signInWithPassword({
          email,
          password
        });

        if (error) {
          msg.textContent = 'Credenciales inválidas o error de conexión';
          btn.disabled = false;
          btn.textContent = 'Ingresar';
          return;
        }

        if (data.user) {
          // 2. Consultar el rol del usuario para redirigir
          const { data: perfil, error: errorPerfil } = await supabase
            .from('perfiles')
            .select('rol')
            .eq('id', data.user.id)
            .single();

          if (errorPerfil) {
            // Si no hay perfil aún, lo mandamos al dashboard por defecto
            window.location.href = '/dashboard';
            return;
          }

          // 3. Redirección basada en rol
          if (perfil.rol === 'admin') {
            window.location.href = '/admin';
          } else {
            window.location.href = '/dashboard';
          }
        }
      });
    </script>
  </body>
</html>