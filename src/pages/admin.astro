---
// src/pages/admin.astro
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Panel de Administración - AG3D</title>
  </head>
  <body class="bg-gray-100 text-gray-800 font-sans flex h-screen overflow-hidden relative">
    
    <aside class="w-64 bg-gray-900 text-white flex flex-col transition-all shrink-0">
      <div class="p-6 border-b border-gray-800">
        <h2 class="text-2xl font-bold tracking-wider text-blue-400">AG3D Admin</h2>
      </div>
      
      <nav class="flex-1 p-4 space-y-2">
        <button id="tab-pedidos" class="w-full text-left px-4 py-3 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white font-medium transition">
          📦 Gestión de Pedidos
        </button>
        <button id="tab-productos" class="w-full text-left px-4 py-3 rounded-lg bg-blue-600 text-white font-medium transition">
          🏷️ Catálogo (CRUD)
        </button>
        <button id="tab-usuarios" class="w-full text-left px-4 py-3 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white font-medium transition">
          👥 Clientes Registrados
        </button>
      </nav>

      <div class="p-4 border-t border-gray-800">
        <a href="/" class="block w-full text-center px-4 py-2 mb-2 text-sm text-gray-400 hover:text-white transition">Ver sitio web</a>
        <button id="btn-logout" class="w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">
          Cerrar Sesión
        </button>
      </div>
    </aside>

    <main class="flex-1 flex flex-col overflow-y-auto bg-gray-50 p-8">
      
      <section id="section-pedidos" class="hidden">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">Gestión de Pedidos</h1>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
          <p class="text-gray-500 animate-pulse">Cargando base de datos...</p>
        </div>
      </section>

      <section id="section-productos" class="block">
        <div class="flex justify-between items-center mb-6">
          <h1 class="text-3xl font-bold text-gray-900">Catálogo de Productos</h1>
          <button id="btn-nuevo-producto" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-semibold transition shadow-sm">
            + Nuevo Producto
          </button>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-gray-100 text-gray-600 text-sm uppercase tracking-wider border-b border-gray-200">
                  <th class="p-4 font-semibold w-16">Foto</th>
                  <th class="p-4 font-semibold">Producto</th>
                  <th class="p-4 font-semibold">Variables</th>
                  <th class="p-4 font-semibold text-right">Acciones</th>
                </tr>
              </thead>
              <tbody id="admin-productos-container" class="divide-y divide-gray-200">
                <tr><td colspan="4" class="p-4 text-center text-gray-500 animate-pulse">Cargando catálogo...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="section-usuarios" class="hidden">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">Directorio de Clientes</h1>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-100 text-gray-600 text-sm uppercase tracking-wider border-b border-gray-200">
                <th class="p-4 font-semibold">Email</th>
                <th class="p-4 font-semibold">Nombre / Empresa</th>
                <th class="p-4 font-semibold">Rol</th>
                <th class="p-4 font-semibold text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="admin-usuarios-container" class="divide-y divide-gray-200">
              <tr><td colspan="4" class="p-4 text-center text-gray-500 italic">No hay clientes registrados aún.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

    </main>

    <div id="modal-producto" class="fixed inset-0 bg-black bg-opacity-50 hidden flex-col items-center justify-center z-50 px-4 transition-opacity">
      <div class="bg-white p-6 rounded-xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
        <h3 id="modal-producto-titulo" class="text-xl font-bold text-gray-900 mb-6">Agregar Producto</h3>
        
        <form id="form-producto" class="space-y-4">
          <input type="hidden" id="prod-id" />
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-1">Título del Producto</label>
              <input type="text" id="prod-titulo" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
            </div>
            
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
              <textarea id="prod-desc" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Cantidad Mínima</label>
              <input type="number" id="prod-min" min="1" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Precio (Opcional)</label>
              <input type="number" id="prod-precio" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
            </div>

            <div class="md:col-span-2 bg-blue-50 p-4 rounded-lg border border-blue-100 mt-2">
              <label class="block text-sm font-bold text-blue-900 mb-1">Subir Imágenes (Opcional)</label>
              <input type="file" id="prod-fotos" multiple accept="image/*" class="w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 transition" />
              <div id="preview-fotos-container" class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-4"></div>
              <p class="text-xs text-blue-700 mt-2">Puedes seleccionar varias fotos a la vez. Si subes fotos nuevas, reemplazarán a las anteriores.</p>
            </div>

            <div class="md:col-span-2 border-t border-gray-200 pt-4 mt-2">
              <div class="flex justify-between items-center mb-3">
                <label class="block text-sm font-bold text-gray-800">Variables Opcionales</label>
                <button type="button" id="btn-add-var" class="text-xs bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1.5 rounded-md font-bold transition">+ Agregar Variable</button>
              </div>
              <div id="variables-container" class="space-y-3"></div>
            </div>
          </div>

          <p id="modal-prod-mensaje" class="text-sm font-semibold text-center mt-4 h-4"></p>

          <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-4">
            <button type="button" id="btn-cerrar-modal" class="px-4 py-2 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition">Cancelar</button>
            <button type="submit" id="btn-guardar-producto" class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition">Guardar Producto</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal Visor de Imagen (para el catálogo) -->
    <div id="modal-visor" class="fixed inset-0 bg-black bg-opacity-80 hidden items-center justify-center z-[60] p-4" onclick="this.classList.replace('flex','hidden')">
      <div class="relative max-w-4xl w-full flex flex-col items-center">
        <img id="img-visor" src="" class="max-h-[85vh] rounded-lg shadow-2xl border-4 border-white" />
        <p id="txt-visor" class="text-white mt-4 text-xl font-bold bg-black bg-opacity-50 px-4 py-2 rounded-full"></p>
        <button class="absolute top-0 right-0 text-white text-4xl p-4">&times;</button>
      </div>
    </div>

    <script>
      // @ts-ignore
      import { supabase } from '../lib/supabase';

      document.addEventListener('DOMContentLoaded', async () => {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) { window.location.href = '/login'; return; }

        const { data: perfil } = await supabase.from('perfiles').select('rol').eq('id', session.user.id).single();
        if (!perfil || perfil.rol !== 'admin') { window.location.href = '/dashboard'; return; }

        // Navegación
        const tabs = {
          pedidos: { btn: document.getElementById('tab-pedidos') as HTMLButtonElement, sec: document.getElementById('section-pedidos') as HTMLElement },
          productos: { btn: document.getElementById('tab-productos') as HTMLButtonElement, sec: document.getElementById('section-productos') as HTMLElement },
          usuarios: { btn: document.getElementById('tab-usuarios') as HTMLButtonElement, sec: document.getElementById('section-usuarios') as HTMLElement }
        };

        function switchTab(activeKey: string) {
          Object.entries(tabs).forEach(([key, elements]) => {
            if (key === activeKey) {
              elements.btn.className = 'w-full text-left px-4 py-3 rounded-lg bg-blue-600 text-white font-medium transition';
              elements.sec.classList.remove('hidden');
              elements.sec.classList.add('block');
              if (key === 'usuarios') cargarUsuarios();
            } else {
              elements.btn.className = 'w-full text-left px-4 py-3 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white font-medium transition';
              elements.sec.classList.remove('block');
              elements.sec.classList.add('hidden');
            }
          });
        }
        tabs.pedidos.btn.addEventListener('click', () => switchTab('pedidos'));
        tabs.productos.btn.addEventListener('click', () => switchTab('productos'));
        tabs.usuarios.btn.addEventListener('click', () => switchTab('usuarios'));

        // Elementos CRUD
        const modal = document.getElementById('modal-producto') as HTMLDivElement;
        const btnNuevo = document.getElementById('btn-nuevo-producto') as HTMLButtonElement;
        const btnCerrarModal = document.getElementById('btn-cerrar-modal') as HTMLButtonElement;
        const formProducto = document.getElementById('form-producto') as HTMLFormElement;
        const mensajeModal = document.getElementById('modal-prod-mensaje') as HTMLParagraphElement;
        const btnGuardar = document.getElementById('btn-guardar-producto') as HTMLButtonElement;
        const modalTitulo = document.getElementById('modal-producto-titulo') as HTMLHeadingElement;

        const inputId = document.getElementById('prod-id') as HTMLInputElement;
        const inputTitulo = document.getElementById('prod-titulo') as HTMLInputElement;
        const inputDesc = document.getElementById('prod-desc') as HTMLTextAreaElement;
        const inputMin = document.getElementById('prod-min') as HTMLInputElement;
        const inputPrecio = document.getElementById('prod-precio') as HTMLInputElement;
        const inputFotos = document.getElementById('prod-fotos') as HTMLInputElement; // El nuevo input
        const previewContainer = document.getElementById('preview-fotos-container') as HTMLDivElement;

        const variablesContainer = document.getElementById('variables-container') as HTMLDivElement;
        const btnAddVar = document.getElementById('btn-add-var') as HTMLButtonElement;
        let listaProductos: any[] = [];
        let fotosParaSubir: { file?: File, url: string, variableAsociada: string }[] = [];

        function renderizarPreviews() {
          previewContainer.innerHTML = '';
          
          const allOptions: string[] = [];
          document.querySelectorAll('.var-row').forEach(row => {
            const valuesStr = (row.querySelector('.var-values') as HTMLInputElement).value;
            const vals = valuesStr.split(',').map(s => s.trim()).filter(s => s !== '');
            allOptions.push(...vals);
          });
          
          fotosParaSubir.forEach((item, index) => {
            const div = document.createElement('div');
            div.className = 'relative group border border-gray-200 rounded-lg p-1 bg-white';
            
            let options = `<option value="">General (Sin variable)</option>`;
            allOptions.forEach(opt => {
              options += `<option value="${opt}" ${item.variableAsociada === opt ? 'selected' : ''}>${opt}</option>`;
            });

            div.innerHTML = `
              <img src="${item.url}" class="w-full h-24 object-cover rounded" />
              <select data-index="${index}" class="select-var-foto mt-1 w-full text-[10px] p-1 border rounded">
                ${options}
              </select>
              <button type="button" data-index="${index}" class="btn-remove-foto absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs shadow-lg">×</button>
            `;
            
            div.querySelector('.select-var-foto')?.addEventListener('change', (e) => {
              const target = e.target as HTMLSelectElement;
              fotosParaSubir[parseInt(target.dataset.index!)].variableAsociada = target.value;
            });

            div.querySelector('.btn-remove-foto')?.addEventListener('click', (e) => {
              const target = e.currentTarget as HTMLButtonElement;
              fotosParaSubir.splice(parseInt(target.dataset.index!), 1);
              renderizarPreviews();
            });

            previewContainer.appendChild(div);
          });
        }

        inputFotos.addEventListener('change', () => {
          if (!inputFotos.files) return;
          Array.from(inputFotos.files).forEach(file => {
            fotosParaSubir.push({ file, url: URL.createObjectURL(file), variableAsociada: '' });
          });
          renderizarPreviews();
        });

        function crearFilaDeVariable(clave = '', valores: string[] = []) {
          const row = document.createElement('div');
          row.className = 'flex gap-2 items-start var-row bg-gray-50 p-2 rounded border border-gray-200';
          row.innerHTML = `
            <input type="text" class="var-key w-1/3 px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 text-sm font-medium" placeholder="Ej. Talles" value="${clave}" />
            <input type="text" class="var-values flex-1 px-3 py-1.5 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 text-sm" placeholder="Ej. S, M, L, XL" value="${valores.join(', ')}" />
            <button type="button" class="btn-del-var text-gray-400 hover:text-red-500 p-1.5 transition" title="Eliminar variable">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          `;
          row.querySelector('.btn-del-var')?.addEventListener('click', () => row.remove());
          row.querySelector('.var-key')?.addEventListener('input', () => renderizarPreviews());
          row.querySelector('.var-values')?.addEventListener('input', () => renderizarPreviews());
          variablesContainer.appendChild(row);
        }
        btnAddVar.addEventListener('click', () => crearFilaDeVariable());

        const productosContainer = document.getElementById('admin-productos-container') as HTMLElement;
        const usuariosContainer = document.getElementById('admin-usuarios-container') as HTMLElement;

        async function cargarUsuarios() {
          const { data: usuarios, error } = await supabase.from('perfiles').select('*').order('email');
          if (error || !usuarios) return;

          usuariosContainer.innerHTML = usuarios.map(u => `
            <tr class="hover:bg-gray-50 transition border-b border-gray-100">
              <td class="p-4">
                <p class="font-medium text-gray-900">${u.email || 'Sin email'}</p>
                <p class="text-[10px] text-gray-400 font-mono">${u.id}</p>
              </td>
              <td class="p-4">
                <p class="text-sm text-gray-700">${u.nombre_completo || u.nombre_empresa || '<span class="italic text-gray-400">Perfil incompleto</span>'}</p>
              </td>
              <td class="p-4">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase ${u.rol === 'admin' ? 'bg-purple-100 text-purple-700' : 'bg-green-100 text-green-700'}">${u.rol}</span>
              </td>
              <td class="p-4 text-right">
                <button class="text-blue-600 hover:text-blue-800 text-xs font-bold">Ver Detalles</button>
              </td>
            </tr>
          `).join('');
        }

        const visorModal = document.getElementById('modal-visor') as HTMLDivElement;
        const visorImg = document.getElementById('img-visor') as HTMLImageElement;
        const visorTxt = document.getElementById('txt-visor') as HTMLParagraphElement;

        function abrirVisor(url: string, titulo: string) {
          visorImg.src = url;
          visorTxt.textContent = titulo;
          visorModal.classList.replace('hidden', 'flex');
        }

        async function cargarProductos() {
          const { data: productos, error } = await supabase.from('productos').select('*').order('id');
          if (error) return;
          listaProductos = productos || [];

          if (listaProductos.length > 0) {
            productosContainer.innerHTML = listaProductos.map(prod => {
              const fotosArray = Array.isArray(prod.fotos) ? prod.fotos : (prod.fotos ? [prod.fotos] : []);
              
              const getUrlSafe = (f: any) => {
                if (!f) return null;
                if (typeof f === 'string') {
                  if (f.startsWith('{')) {
                    try { return JSON.parse(f).url; } catch { return null; }
                  }
                  return f;
                }
                return f.url;
              };

              const variables = prod.variables || {};
              
              let textoVariables = '';

              // 1. Botón para Fotos Generales (sin variable o formato antiguo)
              const fotosGenerales = fotosArray.filter((f: any) => {
                if (typeof f === 'string') return true;
                return !f.variableAsociada || f.variableAsociada === '';
              });

              if (fotosGenerales.length > 0) {
                textoVariables += `
                  <button class="btn-ver-var px-2 py-1 rounded text-[10px] capitalize transition mb-1 mr-1 bg-blue-600 text-white hover:bg-blue-700 font-bold shadow-sm" 
                    data-prod-id="${prod.id}" 
                    data-var-key="general">
                    Principal
                  </button>`;
              }

              // 2. Botones para variables específicas
              Object.entries(variables).forEach(([key, values]) => {
                const vals = Array.isArray(values) ? values : [];
                vals.forEach(v => {
                  const tieneFoto = fotosArray.some((f: any) => 
                    typeof f === 'object' && f.variableAsociada === v
                  );
                  textoVariables += `
                    <button class="btn-ver-var px-2 py-1 rounded text-[10px] capitalize transition mb-1 mr-1 ${tieneFoto ? 'bg-blue-600 text-white hover:bg-blue-700 font-bold shadow-sm' : 'bg-gray-100 text-gray-400 cursor-not-allowed border border-gray-200'}" 
                      data-prod-id="${prod.id}" 
                      data-var-key="${v}" 
                      ${!tieneFoto ? 'disabled' : ''}>
                      ${v}
                    </button>`;
                });
              });

              if (!textoVariables) textoVariables = '<span class="text-gray-400 text-xs italic">Ninguna</span>';
              
              // Extraer URL de miniatura de forma segura
              const miniaturaUrl = getUrlSafe(fotosArray[0]);
              const miniatura = miniaturaUrl 
                ? `<img src="${miniaturaUrl}" class="w-12 h-12 object-cover rounded-md border border-gray-200 shadow-sm" />` 
                : `<div class="w-12 h-12 bg-gray-200 rounded-md border border-gray-300 flex items-center justify-center text-xs text-gray-400">Sin img</div>`;

              return `
              <tr class="hover:bg-gray-50 transition border-b border-gray-100">
                <td class="p-4">${miniatura}</td>
                <td class="p-4">
                  <p class="font-bold text-gray-900">${prod.titulo}</p>
                  <p class="text-xs text-gray-500 font-mono">ID: #${prod.id}</p>
                </td>
                <td class="p-4 flex gap-1 flex-wrap">${textoVariables}</td>
                <td class="p-4 text-right space-x-2">
                  <button class="text-blue-600 hover:text-blue-800 font-semibold text-sm btn-editar" data-id="${prod.id}">Editar</button>
                  <button class="text-red-600 hover:text-red-800 font-semibold text-sm btn-eliminar" data-id="${prod.id}">Borrar</button>
                </td>
              </tr>
            `}).join('');

            document.querySelectorAll('.btn-eliminar').forEach(btn => {
              btn.addEventListener('click', async (e) => {
                const target = e.target as HTMLButtonElement;
                const id = target.getAttribute('data-id');
                if (confirm(`¿Estás seguro de borrar este producto?`)) {
                  target.textContent = 'Borrando...';
                  await supabase.from('productos').delete().eq('id', id);
                  cargarProductos();
                }
              });
            });

            document.querySelectorAll('.btn-ver-var').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const target = e.currentTarget as HTMLButtonElement;
                const prodId = target.dataset.prodId;
                const varKey = target.dataset.varKey;
                const prod = listaProductos.find(p => p.id.toString() === prodId);
                const getUrlSafe = (f: any) => (typeof f === 'string' && f.startsWith('{')) ? JSON.parse(f).url : (f.url || f);
                
                if (prod && prod.fotos) {
                  const fotosArr = Array.isArray(prod.fotos) ? prod.fotos : [prod.fotos];
                  const foto = prod.fotos.find((f: any) => {
                    const data = typeof f === 'string' && f.startsWith('{') ? JSON.parse(f) : f;
                    if (varKey === 'general') {
                      return typeof data === 'string' || !data.variableAsociada;
                    }
                    return typeof data === 'object' && data.variableAsociada === varKey;
                  });

                  if (foto) {
                    const urlFinal = getUrlSafe(foto);
                    abrirVisor(urlFinal, `${prod.titulo} - ${varKey === 'general' ? 'Principal' : varKey}`);
                  }
                }
              });
            });

            document.querySelectorAll('.btn-editar').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const target = e.target as HTMLButtonElement;
                const id = target.getAttribute('data-id');
                const productoAEditar = listaProductos.find(p => p.id.toString() === id);
                
                if(productoAEditar) {
                  modalTitulo.textContent = 'Editar Producto';
                  inputId.value = productoAEditar.id;
                  inputTitulo.value = productoAEditar.titulo;
                  inputDesc.value = productoAEditar.descripcion || '';
                  inputMin.value = productoAEditar.cantidad_minima;
                  inputPrecio.value = productoAEditar.precio || '';
                  inputFotos.value = ''; // Limpiamos el input de fotos
                  
                  const fotosEdit = Array.isArray(productoAEditar.fotos) ? productoAEditar.fotos : (productoAEditar.fotos ? [productoAEditar.fotos] : []);

                  // Cargar fotos existentes para previsualización
                  fotosParaSubir = fotosEdit.map((f: any) => {
                    const data = (typeof f === 'string' && f.startsWith('{')) ? JSON.parse(f) : f;
                    return typeof data === 'string' 
                      ? { url: data, variableAsociada: '' } 
                      : { url: data.url, variableAsociada: data.variableAsociada || '' };
                  });
                  renderizarPreviews();
                  
                  variablesContainer.innerHTML = '';
                  if (productoAEditar.variables) {
                    Object.entries(productoAEditar.variables).forEach(([clave, valores]) => {
                      crearFilaDeVariable(clave, valores as string[]);
                    });
                  }
                  
                  mensajeModal.textContent = '';
                  modal.classList.remove('hidden');
                  modal.classList.add('flex');
                }
              });
            });
          }
        }

        cargarProductos();

        btnNuevo.addEventListener('click', () => {
          modalTitulo.textContent = 'Agregar Nuevo Producto';
          formProducto.reset();
          inputId.value = ''; 
          inputFotos.value = '';
          fotosParaSubir = [];
          previewContainer.innerHTML = '';
          variablesContainer.innerHTML = '';
          mensajeModal.textContent = '';
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        });

        btnCerrarModal.addEventListener('click', () => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        });

        // Evento: GUARDAR (CON SUBIDA DE IMÁGENES)
        formProducto.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          btnGuardar.disabled = true;
          btnGuardar.textContent = 'Procesando...';
          mensajeModal.textContent = '';

          try {
            // 1. Manejo de Fotos
            let fotosFinales: { url: string, variableAsociada: string }[] = [];
            
            if (fotosParaSubir.length > 0) {
              mensajeModal.textContent = 'Subiendo imágenes...';
              mensajeModal.className = 'text-sm font-semibold text-center mt-4 h-4 text-blue-500';
              
              for (const item of fotosParaSubir) {
                if (item.file) {
                  const extension = item.file.name.split('.').pop();
                  const nombreUnico = `${Date.now()}-${Math.random().toString(36).substring(2)}.${extension}`;
                  
                  const { error: errorSubida } = await supabase.storage.from('productos').upload(nombreUnico, item.file);
                  if (errorSubida) throw new Error('No se pudo subir la imagen: ' + errorSubida.message);
                  
                  const { data: { publicUrl } } = supabase.storage.from('productos').getPublicUrl(nombreUnico);
                  fotosFinales.push({ 
                    url: publicUrl, 
                    variableAsociada: item.variableAsociada 
                  });
                } else {
                  // Ya era una URL existente de Supabase
                  fotosFinales.push({ 
                    url: item.url, 
                    variableAsociada: item.variableAsociada 
                  });
                }
              }
            }
            
            mensajeModal.textContent = 'Guardando datos...';

            // 2. Empaquetar Variables
            const objetoVariables: Record<string, string[]> = {};
            document.querySelectorAll('.var-row').forEach(row => {
              const clave = (row.querySelector('.var-key') as HTMLInputElement).value.trim();
              const textoValores = (row.querySelector('.var-values') as HTMLInputElement).value;
              if (clave !== '' && textoValores.trim() !== '') {
                const arrayValores = textoValores.split(',').map(s => s.trim()).filter(s => s !== '');
                if (arrayValores.length > 0) objetoVariables[clave] = arrayValores;
              }
            });

            // 3. Crear el paquete final
            const datosDelProducto = {
              titulo: inputTitulo.value.trim(),
              descripcion: inputDesc.value.trim(),
              cantidad_minima: parseInt(inputMin.value),
              precio: parseFloat(inputPrecio.value) || 0,
              variables: objetoVariables,
              fotos: fotosFinales // Inyectamos el array de objetos {url, variableAsociada}
            };

            // 4. Enviar a base de datos
            let errorDeSupabase;
            if (inputId.value === '') {
              const { error } = await supabase.from('productos').insert([datosDelProducto]);
              errorDeSupabase = error;
            } else {
              const { error } = await supabase.from('productos').update(datosDelProducto).eq('id', inputId.value);
              errorDeSupabase = error;
            }

            if (errorDeSupabase) throw new Error(errorDeSupabase.message);

            // Éxito
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            cargarProductos();

          } catch (error: any) {
            mensajeModal.textContent = 'Error: ' + error.message;
            mensajeModal.className = 'text-sm font-semibold text-center mt-4 h-4 text-red-500';
          } finally {
            btnGuardar.disabled = false;
            btnGuardar.textContent = 'Guardar Producto';
          }
        });

        const btnLogout = document.getElementById('btn-logout') as HTMLButtonElement;
        btnLogout.addEventListener('click', async () => {
          await supabase.auth.signOut();
          window.location.href = '/login';
        });
      });
    </script>
  </body>
</html>