---
import { supabase } from '../lib/supabase';
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const { data: productos, error } = await supabase.from('productos').select('*').order('id');

const logosDir = path.resolve('public/logos');
let filasLogos: string[][] = [];
if (fs.existsSync(logosDir)) {
  const logos = fs.readdirSync(logosDir)
    .filter(f => f.endsWith('.png'))
    .sort((a, b) => {
      const na = parseInt(a.replace('.png', ''), 10);
      const nb = parseInt(b.replace('.png', ''), 10);
      return na - nb;
    });
  const size = Math.ceil(logos.length / 3);
  filasLogos = [logos.slice(0, size), logos.slice(size, size * 2), logos.slice(size * 2)];
}

const heroDir = path.resolve('public/assets/hero');
interface HeroImage { file: string; webp: string | null; }
let heroImages: HeroImage[] = [];
if (fs.existsSync(heroDir)) {
  const files = fs.readdirSync(heroDir)
    .filter((f: string) => /\.(jpg|jpeg|png|webp)$/i.test(f))
    .sort();
  const names = new Set(files);
  const handled = new Set<string>();
  heroImages = [];
  for (const f of files) {
    if (handled.has(f)) continue;
    if (f.endsWith('.webp')) {
      const base = f.replace(/\.\w+$/, '');
      const orig = files.find((o: string) => !o.endsWith('.webp') && o.replace(/\.\w+$/, '') === base);
      if (orig) {
        heroImages.push({ file: orig, webp: f });
        handled.add(orig);
        handled.add(f);
      } else {
        heroImages.push({ file: f, webp: null });
        handled.add(f);
      }
    } else {
      const webp = f.replace(/\.\w+$/, '.webp');
      if (names.has(webp)) {
        heroImages.push({ file: f, webp });
        handled.add(f);
        handled.add(webp);
      } else {
        heroImages.push({ file: f, webp: null });
        handled.add(f);
      }
    }
  }
}
---

<Layout title="Accesorios e Indumentaria Personalizada">
    <section id="home" class="bg-white py-20 text-center">
      <div class="container mx-auto px-4">
        <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 mb-6">Llevamos tu logo a otro nivel</h1>
        <p class="text-lg md:text-xl text-gray-600 mb-10">Llaveros, indumentaria y accesorios impresos en 3D y personalizados para tu empresa.</p>
        <a href="/catalogo" class="inline-block bg-primary hover:bg-primary-hover text-white text-xl font-bold px-10 py-5 rounded-full transition shadow-xl hover:scale-105 active:scale-95 mb-12">
          Explorar Catálogo
        </a>
        <!-- Hero: carrusel flexible -->
        <div id="hero" class="relative w-full max-w-4xl mx-auto h-72 md:h-96 bg-gray-100 rounded-2xl overflow-hidden shadow-inner border border-gray-200">
          {heroImages.length === 0 ? (
            <img src="/assets/hero-placeholder.jpg" class="w-full h-full object-cover opacity-50" alt="Muestra de impresión 3D" />
          ) : heroImages.length === 1 ? (
            <picture>
              {heroImages[0].webp && <source srcset={`/assets/hero/${heroImages[0].webp}`} type="image/webp" />}
              <img src={`/assets/hero/${heroImages[0].file}`} class="w-full h-full object-cover" alt="Trabajo AG3D" loading="eager" />
            </picture>
          ) : (
            <>
              <div id="hero-track" class="flex h-full transition-transform duration-500 ease-in-out will-change-transform" style="transform: translateX(0%);">
                {heroImages.map((img, i) => (
                  <div key={i} class="w-full h-full flex-shrink-0">
                    <picture>
                      {img.webp && <source srcset={`/assets/hero/${img.webp}`} type="image/webp" />}
                      <img src={`/assets/hero/${img.file}`} alt={`Trabajo AG3D ${i + 1}`} class="w-full h-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
                    </picture>
                  </div>
                ))}
              </div>
              <div id="hero-dots" class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 z-10">
                {heroImages.map((_, i) => (
                  <button key={i} class="hero-dot w-3 h-3 rounded-full bg-white/60 hover:bg-white/90 transition-all duration-200" data-index={i} aria-label={`Foto ${i + 1}`}></button>
                ))}
              </div>
            </>
          )}
        </div>
      </div>
    </section>

    <section id="clientes" class="bg-secondary text-white py-20 text-center overflow-hidden scroll-mt-28">
      <div class="container mx-auto px-4 mb-10">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white">Confían en nosotros</h2>
        <p class="text-lg text-gray-300">Empresas que ya tienen sus productos AG3D.</p>
      </div>
      <div class="space-y-10">
        {filasLogos.map((fila, i) => (
          <div class="logos-fila relative overflow-hidden w-full">
            <div class="logos-track flex items-center gap-16 md:gap-20" style={`animation: scrollLogos-${i} 80s linear infinite;`}>
              {fila.map(l => <img src={`/logos/${l}`} alt="Cliente" loading="lazy" class="logo-img" />)}
              {fila.map(l => <img src={`/logos/${l}`} alt="Cliente" loading="lazy" class="logo-img" />)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <style>
      .logos-track {
        width: max-content;
        will-change: transform;
      }
      @keyframes scrollLogos-0 {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      @keyframes scrollLogos-1 {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      @keyframes scrollLogos-2 {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .logo-img {
        height: 4rem;
        width: auto;
        opacity: 0.5;
        filter: grayscale(1);
        transition: opacity 0.4s, filter 0.4s;
      }
      .logo-img:hover {
        opacity: 1;
        filter: grayscale(0);
      }
      #hero-track { will-change: transform; }
    </style>

    <section id="nosotros" class="bg-white py-20 scroll-mt-28">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-3xl font-bold text-center mb-10">Sobre nosotros</h2>
        <div class="space-y-5 text-gray-700 text-lg leading-relaxed max-w-4xl mx-auto">
          <p>Somos AG3D, un emprendimiento con más de 4 años en el mercado, dedicado a crear productos personalizados para empresas, emprendimientos y marcas.</p>
          <p>Diseñamos y producimos merchandising con logo, como llaveros, indumentaria y accesorios, cuidando cada detalle para que tu marca se vea profesional.</p>
          <p>Trabajamos con atención personalizada, boceto previo y envíos a todo el país.</p>
        </div>
      </div>
    </section>

    <section id="faq" class="py-20 scroll-mt-28">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-3xl font-bold text-center mb-10">Preguntas Frecuentes</h2>
        
        <details class="bg-white mb-4 p-4 rounded-lg shadow cursor-pointer group">
          <summary class="font-semibold text-lg outline-none">¿Cuál es la demora de entrega?</summary>
          <p class="mt-4 text-gray-600">El plazo máximo de producción es de hasta 10 días hábiles, dependiendo del producto, la cantidad y la complejidad del diseño.</p>
        </details>

        <details class="bg-white mb-4 p-4 rounded-lg shadow cursor-pointer group">
          <summary class="font-semibold text-lg outline-none">¿Qué métodos de envío utilizan?</summary>
          <div class="mt-4 text-gray-600 space-y-2">
            <p>Realizamos envíos a todo el país por Andreani o Correo Argentino.</p>
            <p>Podés elegir envío a sucursal o domicilio, según disponibilidad de la empresa de transporte.</p>
          </div>
        </details>

        <details class="bg-white mb-4 p-4 rounded-lg shadow cursor-pointer group">
          <summary class="font-semibold text-lg outline-none">¿Cómo debo enviar el logo?</summary>
          <div class="mt-4 text-gray-600 space-y-2">
            <p>Para trabajar el diseño de la mejor manera, recomendamos enviar el logo en alguno de estos formatos, en este orden de preferencia: .AI, PDF, PNG o JPEG.</p>
            <p>Cuanto mejor sea la calidad del archivo, mejor será el resultado final del producto personalizado.</p>
          </div>
        </details>
      </div>
    </section>
</Layout>

<script>
  (function() {
    const track = document.getElementById('hero-track');
    const dots = document.querySelectorAll('.hero-dot');
    const hero = document.getElementById('hero');
    if (!track || dots.length === 0) return;

    let current = 0;
    let interval = setInterval(next, 5000);
    let timeoutId = null;

    function goTo(index) {
      if (index < 0) index = dots.length - 1;
      if (index >= dots.length) index = 0;
      current = index;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => {
        d.classList.toggle('bg-white/90', i === current);
        d.classList.toggle('bg-white/60', i !== current);
      });
      resetAuto();
    }

    function next() { goTo(current + 1); }

    function resetAuto() {
      clearInterval(interval);
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => { interval = setInterval(next, 5000); }, 8000);
    }

    dots.forEach(d => d.addEventListener('click', () => goTo(Number(d.dataset.index))));

    hero.addEventListener('mouseenter', () => clearInterval(interval));
    hero.addEventListener('mouseleave', () => { interval = setInterval(next, 5000); });

    // Swipe táctil
    let startX = 0;
    let startY = 0;
    let isSwiping = false;

    hero.addEventListener('touchstart', (e) => {
      const touch = e.touches[0];
      startX = touch.clientX;
      startY = touch.clientY;
      isSwiping = false;
    }, { passive: true });

    hero.addEventListener('touchmove', (e) => {
      if (!startX) return;
      const dx = Math.abs(e.touches[0].clientX - startX);
      const dy = Math.abs(e.touches[0].clientY - startY);
      if (dx > dy && dx > 10) isSwiping = true;
    }, { passive: true });

    hero.addEventListener('touchend', (e) => {
      if (!isSwiping || !startX) return;
      const endX = e.changedTouches[0].clientX;
      const diff = startX - endX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) goTo(current + 1);
        else goTo(current - 1);
      }
      startX = 0;
      startY = 0;
      isSwiping = false;
    }, { passive: true });
  })();
</script>