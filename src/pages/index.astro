---
import { supabase } from '../lib/supabase';
import '../styles/global.css';

// Traemos TODOS los productos de la tabla, ordenados por su ID
const { data: productos, error } = await supabase.from('productos').select('*').order('id');
---

<html lang="es" class="scroll-smooth">
  <body class="bg-gray-50">
    <header class="bg-secondary text-white sticky top-0 z-50 shadow-md">
      <div class="container mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="transition-transform hover:scale-105 active:scale-95">
          <!-- Ajusta h-10 (40px) según el tamaño que desees para tu logo -->
          <img src="/logo.png" alt="AG3D Logo" class="h-10 w-auto object-contain" />
        </a>

        <!-- Botón Hamburguesa (solo visible en mobile) -->
        <button id="menu-toggle" class="md:hidden p-2 focus:outline-none" aria-label="Abrir menú">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <!-- Navegación Desktop -->
        <nav class="hidden md:flex gap-6 items-center">
          <a href="#home" class="hover:text-primary transition">Home</a>
          <a href="#catalogo" class="hover:text-primary transition">Catálogo</a>
          <a href="#clientes" class="hover:text-primary transition">Clientes</a>
          <a href="#faq" class="hover:text-primary transition">FAQ</a>
          <a href="#nosotros" class="hover:text-primary transition">Nosotros</a>
          <a id="nav-auth-btn" href="/login" class="ml-4 bg-primary hover:bg-primary-hover text-white px-4 py-2 rounded-full transition font-semibold invisible">Ingresar</a>
        </nav>
      </div>

      <!-- Menú Mobile Desplegable -->
      <div id="mobile-menu" class="hidden md:hidden bg-secondary border-t border-gray-800">
        <nav class="flex flex-col p-4 space-y-4">
          <!-- Sección de Auth prioritaria en mobile -->
          <div id="mobile-auth-container" class="flex flex-col gap-2 pb-4 border-b border-gray-800 invisible">
            <a id="mobile-login-btn" href="/login" class="w-full text-center py-2 bg-primary rounded-lg font-bold">Iniciar Sesión</a>
            <a id="mobile-register-btn" href="/registro" class="w-full text-center py-2 border border-gray-700 rounded-lg font-bold">Registrarse</a>
          </div>
          <a href="#home" class="mobile-link py-2 hover:text-primary transition">Home</a>
          <a href="#catalogo" class="mobile-link py-2 hover:text-primary transition">Catálogo</a>
          <a href="#clientes" class="mobile-link py-2 hover:text-primary transition">Clientes</a>
          <a href="#faq" class="mobile-link py-2 hover:text-primary transition">FAQ</a>
          <a href="#nosotros" class="mobile-link py-2 hover:text-primary transition">Nosotros</a>
        </nav>
      </div>
    </header>

    <section id="home" class="bg-white py-20 text-center">
      <div class="container mx-auto px-4">
        <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 mb-6">Llevamos tu logo a otro nivel</h1>
        <p class="text-lg md:text-xl text-gray-600 mb-10">Llaveros, indumentaria y accesorios impresos en 3D y personalizados para tu empresa.</p>
        <div class="bg-gray-200 h-64 flex items-center justify-center rounded-lg shadow-inner border-2 border-dashed border-gray-400">
          <p class="text-gray-500">[Aquí irá el Carrusel de Imágenes]</p>
        </div>
      </div>
    </section>

   <section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4 w-full max-w-7xl">
    
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900 tracking-tight">
      Nuestros productos
    </h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
      {productos?.map((producto) => {
        // Función robusta para extraer la URL
        const getUrl = (f: any) => {
          if (!f) return null;
          if (typeof f === 'string') {
            // Si es un string que parece JSON, lo parseamos
            if (f.startsWith('{')) {
              try { return JSON.parse(f).url; } catch { return null; }
            }
            return f; // Es una URL directa (formato viejo)
          }
          return f.url; // Es un objeto (formato nuevo)
        };

        const fotos = Array.isArray(producto.fotos) ? producto.fotos : (producto.fotos ? [producto.fotos] : []);
        const foto1 = getUrl(fotos[0]);
        const foto2 = getUrl(fotos[1]);

        return (
        <div class="bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden border border-gray-100 group">
          
          {foto1 ? (
            <div class="relative w-full h-56 overflow-hidden bg-gray-100">
              
              <img 
                src={foto1} 
                alt={producto.titulo} 
                class={`absolute inset-0 w-full h-full object-cover object-center transition-opacity duration-500 ease-in-out ${foto2 ? 'group-hover:opacity-0' : 'group-hover:opacity-90'}`} 
              />
              
              {foto2 && (
                <img 
                  src={foto2} 
                  alt={`${producto.titulo} - Vista alternativa`} 
                  class="absolute inset-0 w-full h-full object-cover object-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 ease-in-out" 
                />
              )}
            </div>
          ) : (
            <div class="w-full h-56 bg-gray-200 flex items-center justify-center p-6 text-center group-hover:bg-gray-300 transition-colors">
              <span class="text-gray-400 font-medium text-sm">Sin imagen</span>
            </div>
          )}
          
          <div class="p-6 flex flex-col flex-grow">
            <h3 class="text-lg font-bold text-gray-900 mb-2 leading-tight">
              {producto.titulo}
            </h3>
            
            <p class="text-gray-600 text-sm mb-6 line-clamp-2 flex-grow">
              {producto.descripcion}
            </p>
            
            <a href={`/producto/${producto.id}`} class="mt-auto block w-full text-center px-4 py-2.5 bg-primary text-white font-semibold rounded-lg hover:bg-primary-hover active:bg-primary transition-colors shadow-sm">
              Ver detalles
            </a>
          </div>

        </div>
      )})}
    </div>

  </div>
</section>

    <section id="clientes" class="bg-gray-900 text-white py-20 text-center">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-6">Confían en nosotros</h2>
        <p class="mb-10 text-gray-400">Empresas que ya tienen sus productos AG3D.</p>
        <div class="bg-gray-800 h-32 flex items-center justify-center rounded-lg border border-gray-700">
          <p class="text-gray-500">[Carrusel de Logos de Clientes]</p>
        </div>
      </div>
    </section>

    <section id="faq" class="py-20">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-3xl font-bold text-center mb-10">Preguntas Frecuentes</h2>
        
        <details class="bg-white mb-4 p-4 rounded-lg shadow cursor-pointer group">
          <summary class="font-semibold text-lg outline-none">¿Cuál es el pedido mínimo?</summary>
          <p class="mt-4 text-gray-600">El pedido mínimo para llaveros personalizados es de 50 unidades. Para indumentaria, consúltanos.</p>
        </details>

        <details class="bg-white mb-4 p-4 rounded-lg shadow cursor-pointer group">
          <summary class="font-semibold text-lg outline-none">¿Qué formatos de logo aceptan?</summary>
          <p class="mt-4 text-gray-600">Aceptamos formatos vectoriales (.ai, .svg, .eps) o imágenes de alta resolución (.png sin fondo).</p>
        </details>
      </div>
    </section>

    <footer id="nosotros" class="bg-gray-200 py-12">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl font-bold mb-4">Sobre Nosotros</h2>
        <p class="text-gray-700 mb-8 max-w-2xl mx-auto">Somos especialistas en llevar la identidad de tu marca a productos tangibles de alta calidad mediante tecnología de impresión 3D y técnicas tradicionales.</p>
        
        <div class="flex flex-col md:flex-row justify-center gap-8 mt-8 border-t border-gray-400 pt-8">
          <div>
            <h3 class="font-bold text-gray-900">Contacto</h3>
            <p class="text-gray-600">Email: contacto@ag3d.com</p>
          </div>
          <div>
            <h3 class="font-bold text-gray-900">Redes Sociales</h3>
            <p class="text-gray-600">Instagram: @AG3D_oficial</p>
          </div>
        </div>
      </div>
    </footer>
    <script>
  // @ts-ignore
  import { supabase } from '../lib/supabase';

  document.addEventListener('DOMContentLoaded', async () => {
    const authBtn = document.getElementById('nav-auth-btn') as HTMLAnchorElement;
    const mobileAuthContainer = document.getElementById('mobile-auth-container');
    const mobileLoginBtn = document.getElementById('mobile-login-btn') as HTMLAnchorElement;
    const mobileRegisterBtn = document.getElementById('mobile-register-btn') as HTMLAnchorElement;

    const { data: { session } } = await supabase.auth.getSession();
    
    if (session) {
      const metadata = session.user.user_metadata;
      
      await supabase.from('perfiles').upsert({ 
        id: session.user.id, 
        email: session.user.email,
        nombre_completo: metadata.nombre_completo,
        telefono: metadata.telefono,
        nombre_empresa: metadata.nombre_empresa,
        instagram: metadata.instagram,
        last_login: new Date().toISOString()
      });

      if (authBtn) {
        authBtn.textContent = 'Mi Panel';
        authBtn.classList.remove('invisible');
        authBtn.className = 'ml-4 bg-primary hover:bg-primary-hover text-white px-5 py-2 rounded-full transition font-bold shadow-lg';
        
        const { data: perfil } = await supabase.from('perfiles').select('rol').eq('id', session.user.id).single();
        const targetPath = perfil?.rol === 'admin' ? '/admin' : '/dashboard';
        authBtn.href = targetPath;

        // Mobile: Actualizamos los botones del menú desplegable
        if (mobileAuthContainer && mobileLoginBtn) {
          mobileLoginBtn.textContent = 'Mi Panel';
          mobileLoginBtn.href = targetPath;
          mobileLoginBtn.className = 'w-full text-center py-2 bg-primary rounded-lg font-bold';
          mobileRegisterBtn?.classList.add('hidden'); // Ocultamos registro si ya está logueado
          mobileAuthContainer.classList.remove('invisible');
        }
      }
    } else {
      authBtn?.classList.remove('invisible');
      mobileAuthContainer?.classList.remove('invisible');
    }

    // Lógica para abrir/cerrar el menú mobile
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    menuToggle?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
      // Cambiamos el icono entre hamburguesa y X
      if (mobileMenu?.classList.contains('hidden')) {
        menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      } else {
        menuIcon?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      }
    });

    // Cerrar el menú automáticamente al hacer clic en un link (útil para anchors en la misma página)
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      });
    });
  });
</script>

  </body>
</html>