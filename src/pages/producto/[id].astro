---
// src/pages/producto/[id].astro
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: productos } = await supabase.from('productos').select('id');
  return (productos || []).map((prod) => ({
    params: { id: prod.id.toString() },
  }));
}

const { id } = Astro.params;
const { data: producto } = await supabase.from('productos').select('*').eq('id', id).single();

if (!producto) {
  return Astro.redirect('/404');
}

const variablesSeguras = producto.variables || {};
const fotos = Array.isArray(producto.fotos) ? producto.fotos : (producto.fotos ? [producto.fotos] : []);

// Función de ayuda para extraer la URL (Server Side)
const getUrl = (f: any) => {
  if (!f) return null;
  if (typeof f === 'string') {
    if (f.startsWith('{')) {
      try { return JSON.parse(f).url; } catch { return f; }
    }
    return f;
  }
  return f.url;
};

const fotoInicial = getUrl(fotos[0]);

// Preparación: en el futuro traeremos el mapeo desde la base de datos (Ej: {"Negro": 1})
const mapeoFotos = producto.mapeo_fotos || {}; 
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{producto.titulo} - AG3D</title>
  </head>
  <body class="bg-gray-50 text-gray-800 font-sans">
    
    <header class="bg-secondary text-white sticky top-0 z-50 shadow-md">
      <div class="container mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="transition-transform hover:scale-105 active:scale-95">
          <img src="/logo.png" alt="AG3D Logo" class="h-10 w-auto object-contain" />
        </a>

        <!-- Botón Hamburguesa -->
        <button id="menu-toggle" class="lg:hidden p-2 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <!-- Navegación Desktop -->
        <nav class="hidden lg:flex gap-6 items-center">
          <a href="/" class="hover:text-primary transition">Home</a>
          <a href="/#catalogo" class="hover:text-primary transition">Catálogo</a>
          <a href="/#faq" class="hover:text-primary transition">FAQ</a>
          <a id="nav-auth-btn" href="/login" class="ml-4 bg-primary hover:bg-primary-hover text-white px-4 py-2 rounded-full transition font-semibold invisible">Ingresar</a>
        </nav>
      </div>

      <!-- Menú Mobile -->
      <div id="mobile-menu" class="hidden lg:hidden bg-secondary border-t border-gray-800">
        <nav class="flex flex-col p-4 space-y-4">
          <div id="mobile-auth-container" class="flex flex-col gap-2 pb-4 border-b border-gray-800 invisible">
            <a id="mobile-login-btn" href="/login" class="w-full text-center py-4 bg-primary rounded-lg font-bold text-xl">Iniciar Sesión</a>
            <a id="mobile-register-btn" href="/registro" class="w-full text-center py-4 border border-gray-700 rounded-lg font-bold text-xl">Registrarse</a>
          </div>
          <a href="/" class="py-4 text-xl hover:text-primary transition border-b border-gray-800/50">Home</a>
          <a href="/#catalogo" class="py-4 text-xl hover:text-primary transition border-b border-gray-800/50">Catálogo</a>
          <a href="/" class="py-4 text-xl text-primary font-bold italic">← Volver al Catálogo</a>
        </nav>
      </div>
    </header>

    <main class="container mx-auto px-4 py-12 max-w-5xl">
      <div class="bg-white rounded-xl shadow-lg overflow-hidden flex flex-col md:flex-row">
        
        <div class="md:w-1/2 bg-white flex flex-col items-center justify-center p-4 md:p-8 relative group">
          {fotos.length > 0 ? (
            <div 
              class="w-full max-w-md relative" 
              id="galeria-container" 
              data-fotos={JSON.stringify(fotos)}
              data-mapeo={JSON.stringify(mapeoFotos)}
            >
              
              <div class="aspect-square w-full bg-gray-50 rounded-xl flex items-center justify-center overflow-hidden border border-gray-100 shadow-sm relative">
                <img id="foto-principal" src={fotoInicial} alt={producto.titulo} class="w-full h-full object-contain transition-opacity duration-300" />
              </div>

              {fotos.length > 1 && (
                <>
                  <button id="btn-prev" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 rounded-full w-10 h-10 flex items-center justify-center shadow-md font-bold text-xl opacity-0 group-hover:opacity-100 transition-all hover:scale-110">
                    &lt;
                  </button>
                  <button id="btn-next" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 rounded-full w-10 h-10 flex items-center justify-center shadow-md font-bold text-xl opacity-0 group-hover:opacity-100 transition-all hover:scale-110">
                    &gt;
                  </button>
                  
                  <div class="flex justify-center gap-2 mt-4">
                    {fotos.map((_: any, i: number) => (
                      <div class={`w-2.5 h-2.5 rounded-full dot-indicador transition-colors ${i === 0 ? 'bg-primary' : 'bg-gray-300'}`} data-index={i}></div>
                    ))}
                  </div>
                </>
              )}
            </div>
          ) : (
            <div class="w-full min-h-[300px] bg-gray-50 rounded-xl flex items-center justify-center border border-dashed border-gray-300">
              <span class="text-gray-400 text-lg font-medium">Sin imagen disponible</span>
            </div>
          )}
        </div>
        
        <div class="md:w-1/2 p-8 md:p-12">
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{producto.titulo}</h1>
          <p class="text-gray-600 mb-6 text-lg leading-relaxed">{producto.descripcion}</p>
          
          <div class="bg-primary-light border-l-4 border-primary p-4 mb-8">
            <p class="text-primary font-semibold">Pedido mínimo: <span class="text-secondary font-bold">{producto.cantidad_minima} unidades</span></p>
          </div>

          {Object.keys(variablesSeguras).length > 0 && (
            <div class="mb-10 space-y-6">
              {Object.entries(variablesSeguras).map(([clave, valores]) => (
                <div>
                  <span class="block font-bold text-gray-900 capitalize mb-3 text-sm tracking-wide">{clave}:</span>
                  <div class="flex flex-wrap gap-2">
                    {/* @ts-ignore */}
                    {valores.map((valor) => (
                      <button 
                        class="var-btn px-4 py-2 bg-white text-gray-700 rounded-lg text-sm font-medium border-2 border-gray-200 hover:border-primary hover:text-primary transition-all focus:outline-none focus:ring-2 focus:ring-primary-light"
                        data-valor={valor}
                      >
                        {valor}
                      </button>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}

          <a href={`https://wa.me/1234567890?text=Hola,%20quiero%20consultar%20por%20el%20producto:%20${producto.titulo}`} target="_blank" class="inline-block w-full text-center px-8 py-4 bg-accent text-white font-bold rounded-xl hover:bg-green-600 transition-colors shadow-lg hover:shadow-xl">
            Consultar por WhatsApp
          </a>
        </div>
        
      </div>
    </main>

    <script>
      import { supabase } from '../../lib/supabase';

      document.addEventListener('DOMContentLoaded', () => {
        // Lógica de Autenticación para el Header
        const checkAuth = async () => {
          const authBtn = document.getElementById('nav-auth-btn') as HTMLAnchorElement;
          const mobileAuthContainer = document.getElementById('mobile-auth-container');
          const mobileLoginBtn = document.getElementById('mobile-login-btn') as HTMLAnchorElement;
          const mobileRegisterBtn = document.getElementById('mobile-register-btn') as HTMLAnchorElement;

          const { data: { session } } = await supabase.auth.getSession();
          
          if (session) {
            if (authBtn) {
              authBtn.textContent = 'Mi Panel';
              authBtn.classList.remove('invisible');
              authBtn.className = 'ml-4 bg-primary hover:bg-primary-hover text-white px-5 py-2 rounded-full transition font-bold shadow-lg';
              
              const { data: perfil } = await supabase.from('perfiles').select('rol').eq('id', session.user.id).single();
              const targetPath = perfil?.rol === 'admin' ? '/admin' : '/dashboard';
              authBtn.href = targetPath;

              if (mobileAuthContainer && mobileLoginBtn) {
                mobileLoginBtn.textContent = 'Mi Panel';
                mobileLoginBtn.href = targetPath;
                mobileLoginBtn.className = 'w-full text-center py-4 bg-primary rounded-lg font-bold text-xl';
                mobileRegisterBtn?.classList.add('hidden');
                mobileAuthContainer.classList.remove('invisible');
              }
            }
          } else {
            authBtn?.classList.remove('invisible');
            mobileAuthContainer?.classList.remove('invisible');
          }
        };

        checkAuth();

        // Lógica Menú Mobile
        const menuToggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');

        menuToggle?.addEventListener('click', () => {
          mobileMenu?.classList.toggle('hidden');
          if (mobileMenu?.classList.contains('hidden')) {
            menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
          } else {
            menuIcon?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
          }
        });

        const galeria = document.getElementById('galeria-container');
        if (!galeria) return;

        // Extraemos los datos ocultos en el HTML
        const fotosRaw = galeria.getAttribute('data-fotos');
        const mapeoRaw = galeria.getAttribute('data-mapeo');
        
        if (!fotosRaw) return;
        const fotos = JSON.parse(fotosRaw);
        const mapeoFotos = mapeoRaw ? JSON.parse(mapeoRaw) : {};
        
        // Función de ayuda para extraer la URL (Client Side)
        const getUrlSafe = (f: any) => {
          if (!f) return '';
          if (typeof f === 'string') {
            if (f.startsWith('{')) {
              try { return JSON.parse(f).url; } catch { return f; }
            }
            return f;
          }
          return f.url || '';
        };

        const imgPrincipal = document.getElementById('foto-principal') as HTMLImageElement;
        const btnPrev = document.getElementById('btn-prev');
        const btnNext = document.getElementById('btn-next');
        const dots = document.querySelectorAll('.dot-indicador');
        const varBtns = document.querySelectorAll('.var-btn');
        
        let indexActual = 0;

        // Función central para cambiar la imagen
        function cambiarFoto(nuevoIndex: number) {
          if (nuevoIndex < 0 || nuevoIndex >= fotos.length) return;
          indexActual = nuevoIndex;
          
          // Efecto de desvanecimiento
          imgPrincipal.style.opacity = '0.5';
          setTimeout(() => {
            imgPrincipal.src = getUrlSafe(fotos[indexActual]);
            imgPrincipal.style.opacity = '1';
          }, 150);
          
          // Actualizar puntos inferiores
          dots.forEach((dot, i) => {
            if (i === indexActual) {
              dot.classList.replace('bg-gray-300', 'bg-primary');
            } else {
              dot.classList.replace('bg-primary', 'bg-gray-300');
            }
          });
        }

        // Eventos del Carrusel
        if (btnPrev && btnNext) {
          btnPrev.addEventListener('click', () => {
            let nuevo = indexActual - 1;
            if (nuevo < 0) nuevo = fotos.length - 1;
            cambiarFoto(nuevo);
          });

          btnNext.addEventListener('click', () => {
            let nuevo = indexActual + 1;
            if (nuevo >= fotos.length) nuevo = 0;
            cambiarFoto(nuevo);
          });
        }

        // Lógica de click en las variables (talles, colores, etc)
        varBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLButtonElement;
            const valor = target.getAttribute('data-valor');
            
            // Efecto visual: deseleccionamos todos los hermanos y seleccionamos este
            const hermanos = target.parentElement?.querySelectorAll('.var-btn') || [];
            hermanos.forEach(h => {
              h.classList.remove('border-primary', 'bg-primary-light', 'text-primary');
              h.classList.add('border-gray-200', 'text-gray-700');
            });
            target.classList.remove('border-gray-200', 'text-gray-700');
            target.classList.add('border-primary', 'bg-primary-light', 'text-primary');

            // Buscamos si hay una foto que tenga esta variable asociada
            if (valor) {
              const indexEncontrado = fotos.findIndex((f: any) => {
                const data = (typeof f === 'string' && f.startsWith('{')) ? JSON.parse(f) : f;
                return typeof data === 'object' && data.variableAsociada === valor;
              });

              if (indexEncontrado !== -1) {
                cambiarFoto(indexEncontrado);
              } else if (mapeoFotos[valor] !== undefined) {
                // Mantenemos compatibilidad con el mapeo manual si existiera
                cambiarFoto(mapeoFotos[valor]);
              }
            }
          });
        });

      });
    </script>
  </body>
</html>