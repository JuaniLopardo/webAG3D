---
import Layout from '../../layouts/Layout.astro';
export const prerender = false;
---

<Layout title="Producto">
  <main class="container mx-auto px-4 py-12 max-w-5xl">
    <div id="producto-loading" class="text-center py-24">
      <svg class="animate-spin mx-auto w-8 h-8 text-gray-400 mb-3" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>
      <p class="text-gray-500">Cargando producto...</p>
    </div>
    <div id="producto-error" class="hidden text-center py-24">
      <p class="text-red-500 font-bold text-lg" id="producto-error-msg">Producto no encontrado.</p>
      <a href="/catalogo" class="inline-block mt-4 px-6 py-3 bg-primary text-white font-semibold rounded-lg">Volver al catálogo</a>
    </div>
    <div id="producto-container" class="hidden bg-white rounded-xl shadow-lg overflow-hidden flex flex-col md:flex-row"></div>
  </main>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import { addItem, getCountByProducto } from '../../lib/cart.js';
    import { isAdmin } from '../../lib/auth.js';

    const productoId = Number(location.pathname.split('/').pop());
    const loading = document.getElementById('producto-loading');
    const errorDiv = document.getElementById('producto-error');
    const errorMsg = document.getElementById('producto-error-msg');
    const container = document.getElementById('producto-container') as HTMLDivElement;

    function getUrl(f: any): string | null {
      if (!f) return null;
      if (typeof f === 'string') {
        if (f.startsWith('{')) { try { return JSON.parse(f).url; } catch { return null; } }
        return f;
      }
      return f.url || null;
    }

    function renderProducto(p: any) {
      const fotos = Array.isArray(p.fotos) ? p.fotos : (p.fotos ? [p.fotos] : []);
      const variables = p.variables || {};
      const mapeoFotos = p.mapeo_fotos || {};
      const cantidadMinima = Number(p.cantidad_minima) || 1;
      const fotoInicial = getUrl(fotos[0]);
      const tieneVariables = Object.keys(variables).length > 0;

      document.title = `${p.titulo} | AG3D`;

      container.innerHTML = `
        <div class="md:w-1/2 bg-white flex flex-col items-center justify-center p-4 md:p-8 relative group">
          ${fotos.length > 0 ? `
            <div class="w-full max-w-md relative" id="galeria-container" data-fotos='${JSON.stringify(fotos)}' data-mapeo='${JSON.stringify(mapeoFotos)}'>
              <div class="aspect-square w-full bg-gray-50 rounded-xl flex items-center justify-center overflow-hidden border border-gray-100 shadow-sm relative">
                <img id="foto-principal" src="${fotoInicial}" alt="${p.titulo}" class="w-full h-full object-contain transition-opacity duration-300" />
              </div>
              ${fotos.length > 1 ? `
                <button id="btn-prev" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 rounded-full w-10 h-10 flex items-center justify-center shadow-md font-bold text-xl opacity-0 group-hover:opacity-100 transition-all hover:scale-110">&lt;</button>
                <button id="btn-next" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 rounded-full w-10 h-10 flex items-center justify-center shadow-md font-bold text-xl opacity-0 group-hover:opacity-100 transition-all hover:scale-110">&gt;</button>
                <div class="flex justify-center gap-2 mt-4">
                  ${fotos.map((_: any, i: number) => `<div class="w-2.5 h-2.5 rounded-full dot-indicador transition-colors ${i === 0 ? 'bg-primary' : 'bg-gray-300'}" data-index="${i}"></div>`).join('')}
                </div>
              ` : ''}
            </div>
          ` : `
            <div class="w-full min-h-[300px] bg-gray-50 rounded-xl flex items-center justify-center border border-dashed border-gray-300">
              <span class="text-gray-400 text-lg font-medium">Sin imagen disponible</span>
            </div>
          `}
        </div>
        <div class="md:w-1/2 p-8 md:p-12">
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">${p.titulo}</h1>
          <p class="text-gray-600 mb-6 text-lg leading-relaxed">${p.descripcion || ''}</p>
          <div class="bg-primary-light border-l-4 border-primary p-4 mb-8">
            <p class="text-primary font-semibold">Mínimo: <span id="minimo-num" class="text-secondary font-bold">${cantidadMinima} unidades</span></p>
            <p class="text-xs text-gray-500 mt-1">Podés combinar diferentes variables para llegar al mínimo.</p>
          </div>
          ${tieneVariables ? `
            <div class="mb-8 space-y-6">
              ${Object.entries(variables).map(([clave, valores]) => `
                <div>
                  <span class="block font-bold text-gray-900 capitalize mb-3 text-sm tracking-wide">${clave}:</span>
                  <div class="flex flex-wrap gap-2" data-var-group="${clave}">
                    ${(valores as string[]).map(valor => `
                      <button class="var-btn px-4 py-2 bg-white text-gray-700 rounded-lg text-sm font-medium border-2 border-gray-200 hover:border-primary hover:text-primary transition-all focus:outline-none focus:ring-2 focus:ring-primary-light" data-valor="${valor}" data-var-key="${clave}">${valor}</button>
                    `).join('')}
                  </div>
                </div>
              `).join('')}
            </div>
          ` : ''}
          <div id="cliente-only">
            <div class="mb-6">
              <label class="block font-bold text-gray-900 text-sm tracking-wide mb-2">Cantidad:</label>
              <div class="flex items-center gap-3">
                <button id="qty-minus" type="button" class="w-10 h-10 rounded-lg border-2 border-gray-200 hover:border-primary hover:text-primary text-gray-600 font-bold text-lg transition">−</button>
                <input id="qty-input" type="number" min="1" value="1" class="w-20 h-10 text-center border-2 border-gray-200 rounded-lg font-semibold focus:outline-none focus:border-primary" />
                <button id="qty-plus" type="button" class="w-10 h-10 rounded-lg border-2 border-gray-200 hover:border-primary hover:text-primary text-gray-600 font-bold text-lg transition">+</button>
                <span class="text-sm text-gray-500">unidades</span>
              </div>
            </div>
            <div id="cart-status" class="mb-4 text-sm text-gray-600"></div>
            <button id="btn-add-cart" type="button" data-titulo="${p.titulo}" data-foto="${fotoInicial || ''}" data-minimo="${cantidadMinima}" disabled class="w-full px-8 py-4 bg-primary text-white font-bold rounded-xl transition-all shadow-lg hover:shadow-xl disabled:bg-gray-300 disabled:cursor-not-allowed disabled:shadow-none">Agregar al carrito</button>
            <p id="login-hint" class="text-xs text-gray-500 mt-3 text-center"><a href="/login" class="text-primary hover:underline">Iniciá sesión</a> para agregar al carrito.</p>
          </div>
          <div id="admin-only" class="hidden bg-gray-100 border-l-4 border-gray-400 p-4 rounded-r-lg">
            <p class="text-gray-700 font-semibold mb-1">Estás navegando como administrador.</p>
            <p class="text-sm text-gray-500">Para gestionar este producto, andá al <a href="/admin" class="text-primary hover:underline font-semibold">panel de administración</a>.</p>
          </div>
        </div>
      `;

      // Bindear eventos después de renderizar
      bindEvents(fotos, cantidadMinima);
    }

    function bindEvents(fotos: any[], cantidadMinima: number) {
      const galeria = document.getElementById('galeria-container');
      const fotosRaw = galeria?.getAttribute('data-fotos');
      const fotosParsed = fotosRaw ? JSON.parse(fotosRaw) : fotos;

      const imgPrincipal = document.getElementById('foto-principal') as HTMLImageElement;
      const btnPrev = document.getElementById('btn-prev');
      const btnNext = document.getElementById('btn-next');
      const dots = document.querySelectorAll('.dot-indicador');
      const varBtns = document.querySelectorAll('.var-btn');
      const addBtn = document.getElementById('btn-add-cart') as HTMLButtonElement;
      const qtyInput = document.getElementById('qty-input') as HTMLInputElement;
      const qtyMinus = document.getElementById('qty-minus');
      const qtyPlus = document.getElementById('qty-plus');
      const cartStatus = document.getElementById('cart-status') as HTMLDivElement;
      const varGroups = document.querySelectorAll('[data-var-group]');

      let indexActual = 0;
      const seleccion: Record<string, string> = {};
      let currentSession: any = null;

      function getUrlSafe(f: any) {
        if (!f) return '';
        if (typeof f === 'string') {
          if (f.startsWith('{')) { try { return JSON.parse(f).url; } catch { return f; } }
          return f;
        }
        return f.url || '';
      }

      function cambiarFoto(nuevoIndex: number) {
        if (nuevoIndex < 0 || nuevoIndex >= fotosParsed.length) return;
        indexActual = nuevoIndex;
        imgPrincipal.style.opacity = '0.5';
        setTimeout(() => {
          imgPrincipal.src = getUrlSafe(fotosParsed[indexActual]);
          imgPrincipal.style.opacity = '1';
        }, 150);
        dots.forEach((dot, i) => {
          if (i === indexActual) {
            dot.classList.replace('bg-gray-300', 'bg-primary');
          } else {
            dot.classList.replace('bg-primary', 'bg-gray-300');
          }
        });
      }

      if (btnPrev && btnNext) {
        btnPrev.addEventListener('click', () => {
          let nuevo = indexActual - 1;
          if (nuevo < 0) nuevo = fotosParsed.length - 1;
          cambiarFoto(nuevo);
        });
        btnNext.addEventListener('click', () => {
          let nuevo = indexActual + 1;
          if (nuevo >= fotosParsed.length) nuevo = 0;
          cambiarFoto(nuevo);
        });
      }

      varBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const valor = target.getAttribute('data-valor');
          const varKey = target.getAttribute('data-var-key') || '';
          if (!valor || !varKey) return;

          const hermanos = target.parentElement?.querySelectorAll('.var-btn') || [];
          hermanos.forEach(h => {
            h.classList.remove('border-primary', 'bg-primary-light', 'text-primary');
            h.classList.add('border-gray-200', 'text-gray-700');
          });
          target.classList.remove('border-gray-200', 'text-gray-700');
          target.classList.add('border-primary', 'bg-primary-light', 'text-primary');

          seleccion[varKey] = valor;
          actualizarEstado();

          const mapeo = galeria?.getAttribute('data-mapeo');
          const mapeoFotos = mapeo ? JSON.parse(mapeo) : {};
          const indexEncontrado = fotosParsed.findIndex((f: any) => {
            const data = (typeof f === 'string' && f.startsWith('{')) ? JSON.parse(f) : f;
            return typeof data === 'object' && data.variableAsociada === valor;
          });
          if (indexEncontrado !== -1) cambiarFoto(indexEncontrado);
          else if (mapeoFotos[valor] !== undefined) cambiarFoto(mapeoFotos[valor]);
        });
      });

      qtyMinus?.addEventListener('click', () => {
        const v = Math.max(1, Number(qtyInput.value) - 1);
        qtyInput.value = String(v);
        actualizarEstado();
      });
      qtyPlus?.addEventListener('click', () => {
        qtyInput.value = String(Number(qtyInput.value) + 1);
        actualizarEstado();
      });
      qtyInput?.addEventListener('input', () => {
        if (Number(qtyInput.value) < 1) qtyInput.value = '1';
        actualizarEstado();
      });

      function variablesCompletas(): boolean {
        if (varGroups.length === 0) return true;
        for (const g of Array.from(varGroups)) {
          const k = (g as HTMLElement).dataset.varGroup || '';
          if (!seleccion[k]) return false;
        }
        return true;
      }

      function actualizarEstado() {
        const totalEnCarrito = getCountByProducto(productoId);
        if (!currentSession) {
          addBtn.disabled = true;
          addBtn.textContent = 'Iniciá sesión para agregar al carrito';
          cartStatus.innerHTML = '';
          document.getElementById('login-hint')?.classList.remove('hidden');
          return;
        }
        document.getElementById('login-hint')?.classList.add('hidden');

        if (!variablesCompletas()) {
          addBtn.disabled = true;
          addBtn.textContent = 'Elegí todas las variables';
          cartStatus.innerHTML = '';
          return;
        }

        addBtn.disabled = false;
        addBtn.textContent = 'Agregar al carrito';

        if (totalEnCarrito === 0) {
          cartStatus.innerHTML = `<span class="text-gray-500">Podés ir sumando unidades y variables. Podés solicitar cotización al llegar al mínimo de <b>${cantidadMinima}</b>.</span>`;
        } else if (totalEnCarrito < cantidadMinima) {
          const faltan = cantidadMinima - totalEnCarrito;
          cartStatus.innerHTML = `<span class="text-accent">Llevás <b>${totalEnCarrito}</b> en carrito. Faltan <b>${faltan}</b> para el mínimo (podés sumar más variables).</span>`;
        } else {
          cartStatus.innerHTML = `<span class="text-green-600 font-semibold">✓ Mínimo cubierto. Llevás ${totalEnCarrito} en carrito.</span>`;
        }
      }

      addBtn?.addEventListener('click', async () => {
        const cant = Number(qtyInput.value) || 1;
        if (addBtn.disabled) return;
        if (!currentSession) {
          alert('Necesitás iniciar sesión para agregar al carrito.');
          window.location.href = '/login?redirect=' + encodeURIComponent(location.pathname);
          return;
        }
        if (!variablesCompletas()) {
          alert('Elegí una opción de cada variable antes de agregar.');
          return;
        }
        addItem({
          producto_id: productoId,
          titulo: addBtn.dataset.titulo || document.querySelector('h1')?.textContent || '',
          foto_url: addBtn.dataset.foto || getUrlSafe(fotosParsed[0]),
          cantidad_minima: cantidadMinima,
          variables: { ...seleccion },
          cantidad: cant,
        });
        addBtn.textContent = '¡Agregado!';
        addBtn.classList.replace('bg-primary', 'bg-green-500');
        setTimeout(() => {
          addBtn.classList.replace('bg-green-500', 'bg-primary');
          actualizarEstado();
        }, 1500);
      });

      supabase.auth.onAuthStateChange((event, session) => {
        currentSession = session;
        actualizarEstado();
      });

      supabase.auth.getSession().then(({ data: { session } }) => {
        currentSession = session;
        actualizarEstado();
      });
    }

    document.addEventListener('DOMContentLoaded', async () => {
      const { data: producto, error } = await supabase
        .from('productos')
        .select('*')
        .eq('id', productoId)
        .single();

      loading?.classList.add('hidden');

      if (error || !producto) {
        errorDiv?.classList.remove('hidden');
        if (errorMsg) {
          errorMsg.textContent = error ? `Error al cargar producto: ${error.message}` : 'Producto no encontrado.';
        }
        return;
      }

      container.classList.remove('hidden');
      renderProducto(producto);

      const admin = await isAdmin();
      if (admin) {
        document.getElementById('cliente-only')?.classList.add('hidden');
        document.getElementById('admin-only')?.classList.remove('hidden');
      }
    });
  </script>
</Layout>
